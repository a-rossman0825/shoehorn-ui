{
  "name": "shoehorn-ui",
  "version": "0.2.2",
  "description": "Accessibility-first, design-agnostic Vue 3 component library",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "accessibility",
    "a11y",
    "wcag",
    "wai-aria",
    "headless-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-rossman0825/shoehorn-ui.git"
  },
  "bugs": {
    "url": "https://github.com/a-rossman0825/shoehorn-ui/issues"
  },
  "homepage": "https://github.com/a-rossman0825/shoehorn-ui#readme",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/style.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:types": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:browser": "playwright test",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lf": "eslint",
    "lff": "eslint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "pf": "prettier --write",
    "check": "npm run lint && npm run format:check && npm run build:types && npm run test:run && npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.2.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.13.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.2",
    "sass": "^1.97.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.26",
    "vue-eslint-parser": "^10.4.0"
  }
}
